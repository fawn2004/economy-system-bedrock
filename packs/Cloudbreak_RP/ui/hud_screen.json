{
  "namespace": "hud",

  // Cloudbreak sidebar (Core Monitor). The script sends it as a title that
  // starts with a hidden marker: §e§s§b§r = normal panel, §e§s§x§r = raid panel.
  // Titles without a marker are shown as normal titles.

  "cb_sidebar_text": {
    "type": "label",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 6, 5 ],
    "size": [ "default", "default" ],
    "text": "#text",
    "text_alignment": "left",
    "localize": false,
    "shadow": true,
    "layer": 3,
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - '§e§s§b§r') - '§e§s§x§r')",
        "target_property_name": "#text"
      }
    ]
  },

  "cb_sidebar": {
    "type": "image",
    "texture": "textures/ui/cb/sidebar_panel",
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ -3, -12 ],
    "size": [ "100%c + 12px", "100%c + 10px" ],
    "layer": 2,
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - '§e§s§b') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [ { "text@hud.cb_sidebar_text": {} } ]
  },

  "cb_sidebar_raid": {
    "type": "image",
    "texture": "textures/ui/cb/sidebar_panel_raid",
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ -3, -12 ],
    "size": [ "100%c + 12px", "100%c + 10px" ],
    "layer": 2,
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - '§e§s§x') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [ { "text@hud.cb_sidebar_text": {} } ]
  },

  "hud_title_text": {
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "(((#hud_title_text_string - '§e§s§b') = #hud_title_text_string) and ((#hud_title_text_string - '§e§s§x') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "cb_sidebar@hud.cb_sidebar": {} }, { "cb_sidebar_raid@hud.cb_sidebar_raid": {} } ]
      }
    ]
  }
}
