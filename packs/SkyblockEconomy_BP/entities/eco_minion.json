{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "eco:minion",
      "is_spawnable": false,
      "is_summonable": true
    },
    "components": {
      "minecraft:health": {
        "value": 1000,
        "max": 1000
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:persistent": {},
      "minecraft:fire_immune": {},
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  }
                ]
              }
            },
            "interact_text": "action.interact.eco_minion"
          }
        ]
      },
      "minecraft:type_family": {
        "family": [
          "eco_minion",
          "inanimate"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 1.0
      },
      "minecraft:scale": {
        "value": 0.55
      },
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      }
    }
  }
}