              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bar_green": {
          "type": "image",
          "texture": "textures/ui/eco/header_green",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§e§c§o§3') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bar_blue": {
          "type": "image",
          "texture": "textures/ui/eco/header_blue",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§e§c§o§4') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bar_purple": {
          "type": "image",
          "texture": "textures/ui/eco/header_purple",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§e§c§o§5') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bar_orange": {
          "type": "image",
          "texture": "textures/ui/eco/header_orange",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§e§c§o§6') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "title": {
          "type": "label",
          "layer": 5,
          "font_type": "MinecraftTen",
          "font_scale_factor": 1.1,
          "color": [
            1,
            1,
            1
          ],
          "shadow": true,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            9,
            1
          ],
          "size": [
            "100% - 18px",
            "default"
          ],
          "text": "#text",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((((((#title_text - '§e§c§o§1§r') - '§e§c§o§2§r') - '§e§c§o§3§r') - '§e§c§o§4§r') - '§e§c§o§5§r') - '§e§c§o§6§r')",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "close_button": {
    "type": "button",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_exit",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_exit",
        "mapping_type": "focused"
      }
