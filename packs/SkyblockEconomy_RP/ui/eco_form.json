// Skyblock Economy - custom menu layout.
// Generated layout, but safe to hand-edit.
//  * Change the server name shown above the menu: $eco_server_name / $eco_server_tag (in eco_screen)
//  * Textures live in textures/ui/eco/ (regenerate with tools/generate_assets.py)
//  * Title marker:  §e§c§o§<theme>§r   theme 1 red, 2 gold, 3 green, 4 blue, 5 purple, 6 orange
//  * Button badges: put [NEW] or [HOT] anywhere in a button's text
//  * Navigation: buttons tagged [NAV1]-[NAV4] are drawn in a centred row over the
//    grid's first row (tagged buttons + [NAVX] fillers are hidden in the grid)
{
  "namespace": "eco_form",
  "eco_screen": {
    "type": "panel",
    "size": [
      330,
      236
    ],
    "$eco_server_name|default": "§l§fSKYBLOCK",
    "$eco_server_tag|default": "§l§6ECONOMY",
    "controls": [
      {
        "layout": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100%",
            "100%"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "logo@eco_form.logo": {}
            },
            {
              "window@eco_form.window": {}
            }
          ]
        }
      }
    ]
  },
  "logo": {
    "type": "panel",
    "size": [
      "100%",
      30
    ],
    "controls": [
      {
        "name_shadow": {
          "type": "label",
          "text": "$eco_server_name",
          "font_type": "MinecraftTen",
          "font_scale_factor": 2.0,
          "color": [
            0.55,
            0.05,
            0.12
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            2,
            2
          ],
          "layer": 1
        }
      },
      {
        "name": {
          "type": "label",
          "text": "$eco_server_name",
          "font_type": "MinecraftTen",
          "font_scale_factor": 2.0,
          "color": [
            1,
            1,
            1
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            0
          ],
          "layer": 2
        }
      },
      {
        "tag": {
          "type": "label",
          "text": "$eco_server_tag",
          "font_type": "MinecraftTen",
          "font_scale_factor": 1.0,
          "shadow": true,
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            0,
            -2
          ],
          "layer": 2
        }
      }
    ]
  },
  "window": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%",
      "fill"
    ],
    "controls": [
      {
        "header_row": {
          "type": "panel",
          "size": [
            "100%",
            24
          ],
          "controls": [
            {
              "header@eco_form.header": {
                "size": [
                  "100% - 27px",
                  "100%"
                ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle"
              }
            },
            {
              "close@eco_form.close_button": {
                "size": [
                  24,
                  24
                ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle"
              }
            }
          ]
        }
      },
      {
        "gap": {
          "type": "panel",
          "size": [
            "100%",
            3
          ]
        }
      },
      {
        "body@eco_form.body": {}
      }
    ]
  },
  "header": {
    "type": "panel",
    "controls": [
      {
        "bar_red": {
          "type": "image",
          "texture": "textures/ui/eco/header_red",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§e§c§o§1') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bar_gold": {
