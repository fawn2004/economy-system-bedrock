            0
          ]
        }
      }
    ]
  },
  "grid_content": {
    "type": "panel",
    "size": [
      "100% - 6px",
      "100%c"
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "grid": {
          "type": "grid",
          "size": [
            "100%",
            "default"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "grid_item_template": "eco_form.tile",
          "grid_rescaling_type": "horizontal",
          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_length",
