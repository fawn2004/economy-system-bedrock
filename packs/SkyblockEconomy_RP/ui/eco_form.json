// Skyblock Economy - chest-style menu layout (generated by a script, safe to hand-edit).
//  * Forms whose title starts with the marker §e§c§o§<n>§r use this layout (see server_form.json).
//  * The menu is a chest: a 9-wide grid of slots. Scripts (ui.js) lay the buttons out with
//    glass-pane fillers, Go Back / Close in the bottom row and page arrows.
//  * Hovering (or focusing with a controller) a slot shows its name and lore in a tooltip.
//  * The chest is centred on screen; the form body is shown in the tooltip-style box to its
//    left (hidden when empty).
//  * Button text tokens: [F] = filler (no tooltip); [NEW] / [HOT] are removed from the text.
//  * Textures: textures/ui/eco/chest_* (tools/generate_chest_ui.py)
{
  "namespace": "eco_form",
  "eco_screen": {
    "type": "panel",
    "size": [
      340,
      240
    ],
    "controls": [
      {
        "chest@eco_form.chest": {
          "anchor_from": "center",
          "anchor_to": "center"
        }
      },
      {
        "info@eco_form.info_box": {
          "anchor_from": "center",
          "anchor_to": "right_middle",
          "offset": [
            -92,
            0
          ]
        }
      }
    ]
  },
  "info_box": {
    "type": "image",
    "texture": "textures/ui/eco/chest_tooltip",
    "size": [
      134,
      "100%c + 10px"
    ],
    "bindings": [
      {
        "binding_name": "#form_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "text": {
          "type": "label",
          "size": [
            124,
            "default"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            5
          ],
          "shadow": true,
          "color": [
            1,
            1,
            1
          ],
          "font_scale_factor": 0.9,
          "localize": false,
          "text": "#form_text",
          "layer": 3,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      }
    ]
  },
  "chest": {
    "type": "image",
    "texture": "textures/ui/eco/chest_bg",
    "size": [
      176,
      "100%c"
    ],
    "controls": [
      {
        "stack": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            176,
            "100%c"
          ],
          "controls": [
            {
              "title_row": {
                "type": "panel",
                "size": [
                  176,
                  16
                ],
                "controls": [
                  {
                    "title": {
                      "type": "label",
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [
                        8,
                        1
                      ],
                      "size": [
                        160,
                        "default"
                      ],
                      "color": [
                        0.25,
                        0.25,
                        0.25
                      ],
                      "shadow": false,
                      "localize": false,
                      "text": "#text",
                      "layer": 3,
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(((((((#title_text - '§e§c§o§1§r') - '§e§c§o§2§r') - '§e§c§o§3§r') - '§e§c§o§4§r') - '§e§c§o§5§r') - '§e§c§o§6§r') - '§d§b§r')",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "grid_row": {
                "type": "panel",
                "size": [
                  176,
                  "100%c"
                ],
                "controls": [
                  {
                    "grid": {
                      "type": "grid",
                      "size": [
                        162,
                        "default"
                      ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [
                        7,
                        0
                      ],
                      "grid_item_template": "eco_form.slot",
                      "grid_rescaling_type": "horizontal",
                      "collection_name": "form_buttons",
                      "bindings": [
                        {
                          "binding_name": "#form_button_length",
                          "binding_name_override": "#maximum_grid_items"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "bottom_pad": {
                "type": "panel",
                "size": [
                  176,
                  7
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "slot": {
    "type": "panel",
    "size": [
      18,
      18
    ],
    "controls": [
      {
        "button@eco_form.slot_button": {}
      }
    ]
  },
  "slot_button": {
    "type": "button",
    "size": [
      18,
      18
    ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.form_button_click",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.form_button_click",
        "mapping_type": "focused"
      }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "focus_enabled": true,
    "controls": [
      {
        "default": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "controls": [
            {
              "slot_bg": {
                "type": "image",
                "texture": "textures/ui/eco/chest_slot",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "icon": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "layer": 2,
                "anchor_from": "center",
                "anchor_to": "center",
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#texture"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#texture_file_system"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "hover": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "controls": [
            {
              "slot_bg": {
                "type": "image",
                "texture": "textures/ui/eco/chest_slot",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "icon": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "layer": 2,
                "anchor_from": "center",
                "anchor_to": "center",
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#texture"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#texture_file_system"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "highlight": {
                "type": "image",
                "texture": "textures/ui/eco/chest_slot_hover",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 3
              }
            },
            {
              "tooltip": {
                "type": "image",
                "texture": "textures/ui/eco/chest_tooltip",
                "layer": 40,
                "anchor_from": "top_left",
                "anchor_to": "bottom_left",
                "offset": [
                  12,
                  2
                ],
                "size": [
                  "100%c + 8px",
                  "100%c + 7px"
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#form_button_text - '[F]') = #form_button_text)",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "text": {
                      "type": "label",
                      "layer": 41,
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [
                        4,
                        4
                      ],
                      "size": [
                        "default",
                        "default"
                      ],
                      "shadow": true,
                      "color": [
                        1,
                        1,
                        1
                      ],
                      "localize": false,
                      "text": "#text",
                      "bindings": [
                        {
                          "binding_name": "#form_button_text",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((((((((#form_button_text - '[NEW]') - '[HOT]') - '[F]') - '[NAV1]') - '[NAV2]') - '[NAV3]') - '[NAV4]') - '[NAVX]')",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "controls": [
            {
              "slot_bg": {
                "type": "image",
                "texture": "textures/ui/eco/chest_slot",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "icon": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "layer": 2,
                "anchor_from": "center",
                "anchor_to": "center",
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#texture"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons",
                    "binding_name_override": "#texture_file_system"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "highlight": {
                "type": "image",
                "texture": "textures/ui/eco/chest_slot_hover",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 3
              }
            },
            {
              "tooltip": {
                "type": "image",
                "texture": "textures/ui/eco/chest_tooltip",
                "layer": 40,
                "anchor_from": "top_left",
                "anchor_to": "bottom_left",
                "offset": [
                  12,
                  2
                ],
                "size": [
                  "100%c + 8px",
                  "100%c + 7px"
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#form_button_text - '[F]') = #form_button_text)",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "text": {
                      "type": "label",
                      "layer": 41,
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [
                        4,
                        4
                      ],
                      "size": [
                        "default",
                        "default"
                      ],
                      "shadow": true,
                      "color": [
                        1,
                        1,
                        1
                      ],
                      "localize": false,
                      "text": "#text",
                      "bindings": [
                        {
                          "binding_name": "#form_button_text",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((((((((#form_button_text - '[NEW]') - '[HOT]') - '[F]') - '[NAV1]') - '[NAV2]') - '[NAV3]') - '[NAV4]') - '[NAVX]')",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
