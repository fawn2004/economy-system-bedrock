{
  "namespace": "hud",

  // Scoreboard-style sidebar. sidebar.js sends a title starting with the hidden marker
  // §e§s§b§r (the heading, e.g. SKYBLOCK) and a subtitle (the lines). Titles with that
  // marker are drawn here instead of as a big title in the middle of the screen.
  "eco_sidebar": {
    "type": "image",
    "texture": "textures/ui/eco/sidebar_bg",
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [
      -3,
      -10
    ],
    "size": [
      132,
      "100%c + 8px"
    ],
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - '§e§s§b') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "stack": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            132,
            "100%c"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            4
          ],
          "controls": [
            {
              "heading": {
                "type": "image",
                "texture": "textures/ui/eco/sidebar_head",
                "size": [
                  124,
                  12
                ],
                "layer": 3,
                "controls": [
                  {
                    "heading_text": {
                      "type": "label",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "offset": [
                        0,
                        1
                      ],
                      "size": [
                        "default",
                        "default"
                      ],
                      "text": "#text",
                      "localize": false,
                      "shadow": true,
                      "layer": 4,
                      "bindings": [
                        {
                          "binding_name": "#hud_title_text_string"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(#hud_title_text_string - '§e§s§b§r')",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "gap": {
                "type": "panel",
                "size": [
                  132,
                  3
                ]
              }
            },
            {
              "lines": {
                "type": "panel",
                "size": [
                  132,
                  "100%c"
                ],
                "controls": [
                  {
                    "lines_text": {
                      "type": "label",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [
                        7,
                        0
                      ],
                      "size": [
                        120,
                        "default"
                      ],
                      "text": "#text",
                      "text_alignment": "left",
                      "localize": false,
                      "shadow": true,
                      "layer": 4,
                      "bindings": [
                        {
                          "binding_name": "#hud_subtitle_text_string"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "#hud_subtitle_text_string",
                          "target_property_name": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "hud_title_text": {
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - '§e§s§b') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "eco_sidebar@hud.eco_sidebar": {} } ]
      }
    ]
  }
}
